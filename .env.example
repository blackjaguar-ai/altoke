# ---------- Portal ----------
# pk_: publicable, va al bundle del browser a propósito.
NEXT_PUBLIC_PORTAL_PUBLISHABLE_KEY=pk_...
# sk_: SERVER ONLY. Publica la voz del agente y despliega portal.config.ts.
PORTAL_SECRET_KEY=sk_...
PORTAL_SECRET=sk_...          # el CLI lee esta variable
PORTAL_API_URL=https://api.useportal.co

# ---------- LLM (SOLO redacta. Nunca calcula el número) ----------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-5.6-terra
TIMEOUT_MS=2500 # GPU = 1-3s, tiene margen

# ---------- DB ----------
DATABASE_URL=postgres://altoke:altoke@localhost:5432/altoke

# ---------- App ----------
NEXT_PUBLIC_BASE_URL=https://altoke.blackjaguar.dev

# ---------- Moderación (Etapa 1.4) ----------
# Comparte el MISMO valor en DOS lugares:
#   1. Acá (.env real del VPS) - lo leen /api/moderation/check y /strike.
#   2. Como secreto de PORTAL: `npx @portalsdk/cli secrets set MODERATION_WEBHOOK_SECRET <valor>`
#      - lo lee portal.config.ts vía env() en el edge. Sin este paso, el
#      middleware nunca puede llamar a nuestro backend y todo el chat queda
#      en fail-open silencioso (nadie se banea, pero nada rompe tampoco).
# Generar un valor random largo, no una palabra.
MODERATION_WEBHOOK_SECRET=cambia-esto-por-algo-random-y-largo




